import Mathlib

/-! Farkas' lemma for finitely many generators in a real normed space,
proved from conic Carathéodory, closedness of finitely generated cones, and the
Hahn–Banach separation theorem of Mathlib. Used to prove LP strong duality for (P1). -/

open Finset

namespace Madre.Farkas

variable {ι W : Type} [Fintype ι] [DecidableEq ι]

section Caratheodory

variable [AddCommGroup W] [Module ℝ W] (v : ι → W)

/-- The vectors `v i`, `i ∈ t`, are linearly independent. -/
def IndepOn (t : Finset ι) : Prop :=
  ∀ g : ι → ℝ, ∑ i ∈ t, g i • v i = 0 → ∀ i ∈ t, g i = 0

omit [Fintype ι] in
/-- **Conic Carathéodory.** A nonnegative combination of `v i`, `i ∈ s`, is a nonnegative
combination of linearly independent `v i`, `i ∈ t ⊆ s`. -/
theorem conic_caratheodory : ∀ (s : Finset ι) (a : ι → ℝ), (∀ i ∈ s, 0 ≤ a i) →
    ∃ t ⊆ s, IndepOn v t ∧ ∃ b : ι → ℝ, (∀ i ∈ t, 0 ≤ b i) ∧
      ∑ i ∈ t, b i • v i = ∑ i ∈ s, a i • v i := by
  intro s
  induction s using Finset.strongInduction with
  | H s ih =>
    intro a ha
    by_cases hind : IndepOn v s
    · exact ⟨s, subset_rfl, hind, a, ha, rfl⟩
    · unfold IndepOn at hind
      push Not at hind
      obtain ⟨g, hg, i1, hi1, hgi1⟩ := hind
      -- a relation with a positive coefficient
      obtain ⟨μ, hμ, i2, hi2, hμi2⟩ : ∃ μ : ι → ℝ, ∑ i ∈ s, μ i • v i = 0 ∧
          ∃ i ∈ s, 0 < μ i := by
        rcases lt_or_gt_of_ne hgi1 with h | h
        · refine ⟨fun i => -g i, ?_, i1, hi1, by linarith⟩
          simp only [neg_smul, sum_neg_distrib, hg, neg_zero]
        · exact ⟨g, hg, i1, hi1, h⟩
      set Pos := s.filter (fun i => 0 < μ i) with hPos
      have hPne : Pos.Nonempty := ⟨i2, mem_filter.mpr ⟨hi2, hμi2⟩⟩
      obtain ⟨i0, hi0, hmin⟩ := Pos.exists_min_image (fun i => a i / μ i) hPne
      obtain ⟨hi0s, hμ0⟩ := mem_filter.mp hi0
      set θ := a i0 / μ i0 with hθ
      have hθ0 : 0 ≤ θ := div_nonneg (ha i0 hi0s) hμ0.le
      set a' : ι → ℝ := fun i => a i - θ * μ i with ha'
      have ha'0 : ∀ i ∈ s, 0 ≤ a' i := by
        intro i hi
        simp only [ha']
        rcases le_or_gt (μ i) 0 with h | h
        · have := ha i hi; nlinarith
        · have hm := hmin i (mem_filter.mpr ⟨hi, h⟩)
          have := (le_div_iff₀ h).mp hm
          linarith
      have ha'i0 : a' i0 = 0 := by
        simp only [ha', hθ]; field_simp; ring
      have hsum : ∑ i ∈ s, a' i • v i = ∑ i ∈ s, a i • v i := by
        simp only [ha', sub_smul, sum_sub_distrib, mul_smul, ← smul_sum, hμ, smul_zero,
          sub_zero]
      have hsum' : ∑ i ∈ s.erase i0, a' i • v i = ∑ i ∈ s, a i • v i := by
        rw [← hsum, ← sum_erase_add _ _ hi0s, ha'i0, zero_smul, add_zero]
      obtain ⟨t, hts, htind, b, hb, hbsum⟩ := ih (s.erase i0) (erase_ssubset hi0s) a'
        (fun i hi => ha'0 i (mem_of_mem_erase hi))
      exact ⟨t, hts.trans (erase_subset _ _), htind, b, hb, hbsum.trans hsum'⟩

end Caratheodory

section Closed

variable [NormedAddCommGroup W] [NormedSpace ℝ W] (v : ι → W)

/-- The cone generated by finitely many vectors. -/
def cone : Set W := {x | ∃ a : ι → ℝ, (∀ i, 0 ≤ a i) ∧ x = ∑ i, a i • v i}

/-- The coordinates that vanish outside `t`. -/
def supp (t : Finset ι) : Submodule ℝ (ι → ℝ) where
  carrier := {a | ∀ i ∉ t, a i = 0}
  add_mem' := fun ha hb i hi => by simp [ha i hi, hb i hi]
  zero_mem' := fun i _ => rfl
  smul_mem' := fun c a ha i hi => by simp [ha i hi]

/-- a ↦ ∑_{i∈t} a i • v i. -/
noncomputable def combo (t : Finset ι) : (ι → ℝ) →ₗ[ℝ] W :=
  ∑ i ∈ t, (LinearMap.proj i : (ι → ℝ) →ₗ[ℝ] ℝ).smulRight (v i)

omit [Fintype ι] [DecidableEq ι] in
theorem combo_apply (t : Finset ι) (a : ι → ℝ) : combo v t a = ∑ i ∈ t, a i • v i := by
  simp [combo, LinearMap.sum_apply]

theorem isClosed_piece (t : Finset ι) (ht : IndepOn v t) :
    IsClosed ((combo v t).domRestrict (supp t) ''
      {a : supp t | ∀ i, 0 ≤ (a : ι → ℝ) i}) := by
  have hker : LinearMap.ker ((combo v t).domRestrict (supp t)) = ⊥ := by
    rw [LinearMap.ker_eq_bot']
    intro a ha
    have h0 : ∑ i ∈ t, (a : ι → ℝ) i • v i = 0 := by
      rw [← combo_apply]; simpa using ha
    apply Subtype.ext
    funext i
    by_cases hi : i ∈ t
    · exact ht _ h0 i hi
    · exact a.2 i hi
  have hemb := LinearMap.isClosedEmbedding_of_injective hker
  refine hemb.isClosedMap _ ?_
  have e : {a : supp t | ∀ i, 0 ≤ (a : ι → ℝ) i} = ⋂ i, {a : supp t | 0 ≤ (a : ι → ℝ) i} := by
    ext a; simp
  rw [e]
  refine isClosed_iInter fun i => isClosed_le
    (continuous_const : Continuous fun _ : supp t => (0 : ℝ)) ?_
  exact (continuous_apply (A := fun _ : ι => ℝ) i).comp continuous_subtype_val

theorem isClosed_cone : IsClosed (cone v) := by
  classical
  have heq : cone v = ⋃ t ∈ (univ : Finset (Finset ι)).filter (IndepOn v),
      (combo v t).domRestrict (supp t) '' {a : supp t | ∀ i, 0 ≤ (a : ι → ℝ) i} := by
    ext x
    simp only [cone, Set.mem_ofPred_eq, Set.mem_iUnion, mem_filter, mem_univ, true_and,
      Set.mem_image, exists_prop]
    constructor
    · rintro ⟨a, ha, rfl⟩
      obtain ⟨t, -, ht, b, hb, hbsum⟩ := conic_caratheodory v univ a (fun i _ => ha i)
      refine ⟨t, ht, ⟨fun i => if i ∈ t then b i else 0, fun i hi => by simp [hi]⟩, ?_, ?_⟩
      · intro i
        simp only
        split_ifs with h
        · exact hb i h
        · exact le_rfl
      · rw [LinearMap.domRestrict_apply, combo_apply, ← hbsum]
        exact sum_congr rfl fun i hi => by simp [hi]
    · rintro ⟨t, -, a, ha, rfl⟩
      refine ⟨a, ha, ?_⟩
      rw [LinearMap.domRestrict_apply, combo_apply]
      exact sum_subset (subset_univ t) fun i _ hi => by rw [a.2 i hi, zero_smul]
  rw [heq]
  exact isClosed_biUnion_finset fun t ht => isClosed_piece v t (mem_filter.mp ht).2

omit [DecidableEq ι] in
theorem convex_cone : Convex ℝ (cone v) := by
  rintro x ⟨a, ha, rfl⟩ y ⟨b, hb, rfl⟩ p q hp hq _
  refine ⟨fun i => p * a i + q * b i, fun i => by have := ha i; have := hb i; positivity, ?_⟩
  simp only [smul_sum, smul_smul, add_smul, sum_add_distrib]

/-- **Farkas' lemma.** If `b` is not a nonnegative combination of the `v i`, some continuous
linear functional is nonnegative on every `v i` and negative at `b`. -/
theorem farkas (b : W) (hb : b ∉ cone v) :
    ∃ f : StrongDual ℝ W, (∀ i, 0 ≤ f (v i)) ∧ f b < 0 := by
  obtain ⟨f, u, hfu, hub⟩ := geometric_hahn_banach_closed_point (convex_cone v)
    (isClosed_cone v) hb
  have h0 : (0 : W) ∈ cone v := ⟨0, fun _ => le_rfl, by simp⟩
  have hu : 0 < u := by simpa using hfu 0 h0
  refine ⟨-f, fun i => ?_, by simp; linarith⟩
  by_contra hneg
  simp only [neg_apply, neg_nonneg, not_le] at hneg
  -- the ray through v i leaves the half-space {f < u}
  set c := u / f (v i) with hc
  have hmem : c • v i ∈ cone v := by
    refine ⟨fun j => if j = i then c else 0, fun j => ?_, ?_⟩
    · by_cases h : j = i
      · simp only [h, ite_true]; exact (div_pos hu hneg).le
      · simp [h]
    · simp
  have := hfu _ hmem
  rw [map_smul, smul_eq_mul, hc, div_mul_cancel₀ _ hneg.ne'] at this
  exact lt_irrefl _ this

end Closed

end Madre.Farkas
