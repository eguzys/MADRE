//
// SmokeNet — Phase A+: drones + ground users with Bonn-hierarchy traffic.
//
// Drones: AodvRouter with RLControlledMobility, driven by Python over ZMQ.
// Users: AdhocHost leaf nodes (no AODV), stationary in v1. Association
//        handled app-layer by UserAssociationModule (BRP algorithm).
//        Traffic generated by UserBonnTrafficApp (Bonn CBR hierarchy).
// Drones broadcast beacons via DroneBeaconApp every 1 s.
//

package rlsmoke;

import inet.networklayer.configurator.ipv4.Ipv4NetworkConfigurator;
import inet.node.inet.AdhocHost;
import inet.physicallayer.wireless.ieee80211.packetlevel.Ieee80211ScalarRadioMedium;

import rlsmoke.JammerHost;
import rlsmoke.RLBridge;
import rlsmoke.UserHost;


//
// A single drone: RL-driven mobility, ORACLE routing (no discovery protocol).
//
// Not an AodvRouter: AODV's netfilter hook (ensureRouteForDatagram, Aodv.cc:193)
// only ACCEPTs routes carrying AodvRouteData, while RLBridge installs
// MANUAL/IFACENETMASK oracle routes, which carry none, so AODV would queue every
// data packet pending an RREQ to a user node that does not run AODV.
//
// Routing is oracle-provided (RLBridge::rebuildOracleRoutes), consistent with
// the position-oracle reward.
//
module DroneHost extends AdhocHost
{
    parameters:
        int droneId;
        mobility.typename     = default("RLControlledMobility");
        mobility.droneId      = this.droneId;
}


//
// The network: N RL-driven drones + M stationary ground users.
//
network SmokeNet
{
    parameters:
        int numDrones;
        int numUsers;
        @display("bgb=2200,2200");

    submodules:
        radioMedium: Ieee80211ScalarRadioMedium {
            parameters:
                @display("p=-100,-100;is=s");
        }
        configurator: Ipv4NetworkConfigurator {
            parameters:
                config = default(xml("<config><interface hosts='*' address='10.0.x.x' netmask='255.255.0.0'/></config>"));
                @display("p=-100,-100;is=s");
        }
        rlBridge: RLBridge {
            parameters:
                numDrones = parent.numDrones;
                numUsers  = parent.numUsers;
                @display("p=-100,-100;is=s");
        }
        host[numDrones]: DroneHost {
            parameters:
                droneId = index;
                @display("i=device/pocketpc_s;r=,,#707070");
        }
        user[numUsers]: UserHost {
            parameters:
                userId = index;
                @display("i=device/cellphone_s;r=,,#CC3333");
        }
        jammer: JammerHost {
            parameters:
                @display("i=device/accesspoint_s;r=,,#FF0000");
        }

    connections allowunconnected:
}
